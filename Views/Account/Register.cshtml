@model GameStopInventory.Models.User
@{
    ViewData["Title"] = "Create account";
}

<div style="min-height:90vh; display:flex; align-items:center; justify-content:center; padding:2rem;">
    <div style="width:100%; max-width:360px;">
        <a asp-controller="Home" asp-action="Index"
           style="display:inline-flex; align-items:center; gap:6px; color:#666; text-decoration:none; font-size:13px; margin-bottom:1.5rem;">
            ← Back
        </a>
        <div style="background:#1a1a1a; border:1px solid #2a2a2a; border-radius:12px; padding:2rem;">
            <h2 style="color:#fff; font-size:20px; font-weight:500; margin-bottom:0.25rem;">Create account</h2>
            <p style="color:#666; font-size:13px; margin-bottom:1.5rem;">Join the GameStop platform</p>

            <form method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div style="background:#2a1515; border:1px solid #4a2020; border-radius:8px; padding:12px 14px; margin-bottom:1rem;">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p style="color:#ff8a80; font-size:13px; margin:0;">@error.ErrorMessage</p>
                        }
                    </div>
                }

                <div style="margin-bottom:1rem;">
                    <label style="display:block; font-size:12px; color:#888; margin-bottom:6px;">Username</label>
                    <input asp-for="Username" placeholder="choose_a_username"
                           style="width:100%; background:#111; border:1px solid #2a2a2a; color:#fff; padding:10px 12px; border-radius:8px; font-size:14px;" />
                    <span asp-validation-for="Username" style="color:#ff8a80; font-size:12px; margin-top:4px; display:block;"></span>
                </div>

                <div style="margin-bottom:1rem;">
                    <label style="display:block; font-size:12px; color:#888; margin-bottom:6px;">Email</label>
                    <input asp-for="Email" type="email" placeholder="you@example.com"
                           style="width:100%; background:#111; border:1px solid #2a2a2a; color:#fff; padding:10px 12px; border-radius:8px; font-size:14px;" />
                    <span asp-validation-for="Email" style="color:#ff8a80; font-size:12px; margin-top:4px; display:block;"></span>
                </div>

                <div style="margin-bottom:1.25rem;">
                    <label style="display:block; font-size:12px; color:#888; margin-bottom:6px;">Password</label>
                    <input asp-for="Password" type="password" placeholder="••••••••"
                           style="width:100%; background:#111; border:1px solid #2a2a2a; color:#fff; padding:10px 12px; border-radius:8px; font-size:14px;" />
                    <span asp-validation-for="Password" style="color:#ff8a80; font-size:12px; margin-top:4px; display:block;"></span>
                </div>

                <button type="submit"
                        style="width:100%; background:#e53e1a; color:#fff; border:none; padding:11px; border-radius:8px; font-size:14px; font-weight:500; cursor:pointer;">
                    Create account
                </button>
            </form>

            <p style="text-align:center; margin-top:1rem; font-size:13px; color:#666;">
                Already have one?
                <a asp-action="Login" style="color:#e53e1a; text-decoration:none;">Sign in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}