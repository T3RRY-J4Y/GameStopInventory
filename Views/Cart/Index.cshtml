@model List<GameStopInventory.Models.CartItem>

@{
    ViewData["Title"] = "Your Cart";
}

<div style="padding:2rem; max-width:800px; margin:0 auto;">
    <h2 style="color:#fff; font-size:22px; font-weight:500; margin-bottom:1.5rem;">Your cart</h2>

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:4rem; color:#444;">
            <p style="font-size:16px;">Your cart is empty.</p>
            <a asp-controller="Games" asp-action="Index"
               style="color:#e53e1a; text-decoration:none; font-size:14px;">
                Browse games →
            </a>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div style="background:#1a1a1a; border:1px solid #2a2a2a; border-radius:12px; padding:1rem; margin-bottom:1rem; display:flex; align-items:center; gap:1rem;">
                @if (item.CoverImageUrl != null)
                {
                    <img src="@item.CoverImageUrl" style="width:70px; height:70px; object-fit:cover; border-radius:8px;" />
                }
                else
                {
                    <div style="width:70px; height:70px; background:#222; border-radius:8px; display:flex; align-items:center; justify-content:center; color:#444; font-size:11px;">
                        No img
                    </div>
                }
                <div style="flex:1;">
                    <p style="color:#fff; font-size:15px; font-weight:500; margin-bottom:4px;">@item.Title</p>
                    <p style="color:#666; font-size:13px;">Qty: @item.Quantity</p>
                </div>
                <p style="color:#e53e1a; font-size:15px; font-weight:500;">
                    R@((item.Price * item.Quantity).ToString("0.00"))
                </p>
                <form method="post" asp-action="Remove">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="gameId" value="@item.GameId" />
                    <button type="submit"
                            style="background:transparent; border:1px solid #2a1515; color:#e53e1a; padding:6px 12px; border-radius:6px; font-size:12px; cursor:pointer;">
                        Remove
                    </button>
                </form>
            </div>
        }

        <div style="background:#1a1a1a; border:1px solid #2a2a2a; border-radius:12px; padding:1.25rem; margin-top:1rem;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="color:#888; font-size:14px;">Total</span>
                <span style="color:#fff; font-size:20px; font-weight:500;">
                    R@(Model.Sum(i => i.Price * i.Quantity).ToString("0.00"))
                </span>
            </div>
            <form method="post" asp-action="Checkout" style="margin-top:1rem;">
                @Html.AntiForgeryToken()
                <button type="submit"
                        style="width:100%; background:#e53e1a; color:#fff; border:none; padding:12px; border-radius:8px; font-size:14px; font-weight:500; cursor:pointer;">
                    Checkout
                </button>
            </form>
        </div>
    }
</div>