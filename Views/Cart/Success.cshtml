@{
    ViewData["Title"] = "Order Placed";
}

<div style="min-height:80vh; display:flex; align-items:center; justify-content:center; text-align:center; padding:2rem;">
    <div>
        <div style="width:64px; height:64px; background:#1a2a1a; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
            <span style="color:#4caf7d; font-size:28px;">✓</span>
        </div>
        <h2 style="color:#fff; font-size:24px; font-weight:500; margin-bottom:0.5rem;">Order placed!</h2>
        <p style="color:#666; font-size:14px; margin-bottom:2rem;">Your order has been successfully processed.</p>
        <a asp-controller="Games" asp-action="Index"
           style="background:#e53e1a; color:#fff; padding:12px 32px; border-radius:8px; text-decoration:none; font-size:14px; font-weight:500;">
            Continue shopping
        </a>
    </div>
</div>