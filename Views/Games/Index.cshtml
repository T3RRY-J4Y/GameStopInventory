@model IEnumerable<GameStopInventory.Models.Game>
@{
    ViewData["Title"] = "Inventory";
}

<div style="padding:2rem; max-width:1200px; margin:0 auto;">

    @if (TempData["Message"] != null)
    {
        <div style="background:#1a2a1a; border:1px solid #2a4a2a; border-radius:8px; padding:12px 16px; margin-bottom:1.5rem; color:#4caf7d; font-size:14px;">
            ✓ @TempData["Message"]
        </div>
    }

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
        <h2 style="color:#fff; font-size:22px; font-weight:500;">All games</h2>
        @if (Context.Session.GetString("Role") == "Admin")
        {
            <a asp-action="Create"
               style="background:#e53e1a; color:#fff; padding:9px 20px; border-radius:8px; text-decoration:none; font-size:13px; font-weight:500;">
                + Add game
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:4rem; color:#444;">
            <p style="font-size:16px;">No games in inventory yet.</p>
            @if (Context.Session.GetString("Role") == "Admin")
            {
                <a asp-action="Create" style="color:#e53e1a; text-decoration:none; font-size:14px;">Add your first game →</a>
            }
        </div>
    }
    else
    {
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:16px;">
            @foreach (var game in Model)
            {
                <div style="background:#1a1a1a; border:1px solid #2a2a2a; border-radius:12px; overflow:hidden;">
                    @if (game.CoverImageUrl != null)
                    {
                        <img src="@game.CoverImageUrl"
                             style="width:100%; height:160px; object-fit:cover;"
                             onerror="this.parentElement.innerHTML='<div style=height:160px;background:#222;display:flex;align-items:center;justify-content:center;color:#444;font-size:13px;>No image</div>'" />
                    }
                    else
                    {
                        <div style="height:160px; background:#222; display:flex; align-items:center; justify-content:center; color:#444; font-size:13px;">
                            No image
                        </div>
                    }
                    <div style="padding:12px;">
                        <p style="color:#fff; font-size:14px; font-weight:500; margin-bottom:4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                            @game.Title
                        </p>
                        <p style="color:#666; font-size:12px; margin-bottom:8px;">@game.Genre</p>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                            <span style="color:#e53e1a; font-size:14px; font-weight:500;">R@(game.Price.ToString("0.00"))</span>
                            <span style="background:#1a2a1a; color:#4caf7d; font-size:11px; padding:2px 8px; border-radius:4px;">
                                @game.StockLevel left
                            </span>
                        </div>

                        @if (Context.Session.GetString("Username") != null)
                        {
                            <form method="post" asp-controller="Cart" asp-action="Add">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="gameId" value="@game.Id" />
                                <button type="submit"
                                        style="width:100%; background:#e53e1a; color:#fff; border:none; padding:7px; border-radius:6px; font-size:12px; font-weight:500; cursor:pointer; margin-bottom:6px;">
                                    Add to cart
                                </button>
                            </form>
                        }

                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <div style="display:flex; gap:6px;">
                                <a asp-action="Edit" asp-route-id="@game.Id"
                                   style="flex:1; text-align:center; background:transparent; border:1px solid #333; color:#888; padding:5px; border-radius:6px; text-decoration:none; font-size:12px;">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@game.Id"
                                   style="flex:1; text-align:center; background:transparent; border:1px solid #2a1515; color:#e53e1a; padding:5px; border-radius:6px; text-decoration:none; font-size:12px;">
                                    Delete
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>